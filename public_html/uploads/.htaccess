Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|php8)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|php8)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
